{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "1.13",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "manictime-tracker@jhit.org",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "compose",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "default_locale": "en",
  "icons": {
    "48": "manictime.png",
    "96": "manictime.png"
  }
}